{
  "manifest_version": 3,
  "name": "汲流 · 下载助手",
  "version": "1.6.0",
  "description": "接管浏览器下载，按文件类型自动选引擎；视频右上角悬浮一键交给汲流（IDM 风格）；网络层媒体嗅探（m3u8/mp4 自动列进 popup）；一键交给本地下载器（或 Motrix / aria2）。",
  "minimum_chrome_version": "111",

  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "downloads",
    "webRequest"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "汲流下载助手"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
