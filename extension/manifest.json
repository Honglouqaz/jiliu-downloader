{
  "manifest_version": 3,
  "name": "汲流 · 下载助手",
  "version": "1.9.6",
  "description": "接管浏览器下载，按文件类型自动选引擎；汲流没开着时用 jiliu:// 协议自动唤起再补投任务（登录态一个字节都不出内存）；网络层媒体嗅探（m3u8/mp4 自动列进 popup）；播放器外侧可拖动的下载按钮；页面右下角的速度/进度悬浮窗（自动轮转）。",
  "minimum_chrome_version": "111",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "downloads",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "汲流下载助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
